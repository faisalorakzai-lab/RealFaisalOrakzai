{
  "buildCommand": "pnpm --filter @workspace/faisal-os run build",
  "outputDirectory": "artifacts/faisal-os/dist/public",
  "installCommand": "pnpm install --frozen-lockfile",
  "redirects": [
    {
      "source": "/story",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/ventures",
      "destination": "/ecosystem",
      "permanent": true
    },
    {
      "source": "/bio",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/founder-en",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/bond",
      "destination": "https://orakzaibond.com",
      "permanent": false
    },
    {
      "source": "/shamim",
      "destination": "https://www.shamimforever.com",
      "permanent": false
    },
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/in/faisalorakzaii",
      "permanent": false
    },
    {
      "source": "/twitter",
      "destination": "https://x.com/faisalorakzaii",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/faisalorakzai-lab",
      "permanent": false
    },
    {
      "source": "/wikidata",
      "destination": "https://www.wikidata.org/wiki/Q140264666",
      "permanent": false
    },
    {
      "source": "/orcid",
      "destination": "https://orcid.org/0009-0000-0915-7272",
      "permanent": false
    },
    {
      "source": "/crunchbase",
      "destination": "https://www.crunchbase.com/person/faisal-orakzai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/papers/:paper",
      "destination": "/papers/:paper.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    },
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/research-sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/papers/(.*)",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/html; charset=utf-8"
        },
        {
          "key": "X-Robots-Tag",
          "value": "index, follow"
        }
      ]
    }
  ]
}