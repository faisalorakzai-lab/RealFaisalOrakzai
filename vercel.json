{
  "buildCommand": "pnpm --filter @workspace/faisal-os run build",
  "outputDirectory": "artifacts/faisal-os/dist/public",
  "installCommand": "pnpm install",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "faisalorakzai.vercel.app"
        }
      ],
      "destination": "https://faisalorakzai.com/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.faisalorakzai.com"
        }
      ],
      "destination": "https://faisalorakzai.com/$1",
      "permanent": true
    },
    {
      "source": "/story",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/ventures",
      "destination": "/ecosystem",
      "permanent": true
    },
    {
      "source": "/bio",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/founder-en",
      "destination": "/founder",
      "permanent": true
    },
    {
      "source": "/bond",
      "destination": "https://orakzaibond.com",
      "permanent": false
    },
    {
      "source": "/shamim",
      "destination": "https://www.shamimforever.com",
      "permanent": false
    },
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/in/faisalorakzaii",
      "permanent": false
    },
    {
      "source": "/twitter",
      "destination": "https://x.com/faisalorakzaii",
      "permanent": false
    },
    {
      "source": "/github",
      "destination": "https://github.com/faisalorakzai-lab",
      "permanent": false
    },
    {
      "source": "/wikidata",
      "destination": "https://www.wikidata.org/wiki/Q140264666",
      "permanent": false
    },
    {
      "source": "/orcid",
      "destination": "https://orcid.org/0009-0000-0915-7272",
      "permanent": false
    },
    {
      "source": "/crunchbase",
      "destination": "https://www.crunchbase.com/person/faisal-orakzai",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/papers/:paper",
      "destination": "/papers/:paper.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/founder",
      "destination": "/index.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/index.html"
    },
    {
      "source": "/benchmarks",
      "destination": "/index.html"
    },
    {
      "source": "/research",
      "destination": "/index.html"
    },
    {
      "source": "/research/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/press",
      "destination": "/index.html"
    },
    {
      "source": "/learning",
      "destination": "/index.html"
    },
    {
      "source": "/media",
      "destination": "/index.html"
    },
    {
      "source": "/investment",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    },
    {
      "source": "/okzbyte-hub",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/index.html"
    },
    {
      "source": "/editorial-policy",
      "destination": "/index.html"
    },
    {
      "source": "/cookie-policy",
      "destination": "/index.html"
    },
    {
      "source": "/ai-usage-policy",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/founder",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/founder>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/ecosystem",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/ecosystem>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/benchmarks",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/benchmarks>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/research",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/research>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/press",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/press>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/learning",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/learning>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/media",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/media>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/investment",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/investment>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/contact",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/contact>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/research/blockchain-basic",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/research/blockchain-basic>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/research/blockchain-infra",
      "headers": [
        {
          "key": "Link",
          "value": "<https://faisalorakzai.com/research/blockchain-infra>; rel=\"canonical\""
        }
      ]
    },
    {
      "source": "/research/blockchain-types",
      "headers": [
        {
